# -----------------------------------------------------------------------------
# AIW Review Engine
# -----------------------------------------------------------------------------
# Copy to .env.local for local work. In production these live in Vercel's
# environment variables. Never commit the filled-in file.

# Public base URL. Every review link and QR code is built from this, so it must
# be the real production host, not localhost, once you go live.
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Supabase, from Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, from resend.com. The sending domain must be verified there first,
# which means adding the SPF, DKIM and DMARC records to the client's DNS.
RESEND_API_KEY=
# Fallback sender when a business has not set its own. Must be on a verified domain.
DEFAULT_FROM_EMAIL=reviews@example.com
DEFAULT_FROM_NAME=Reviews

# Shared secret for the follow-up cron endpoint. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
