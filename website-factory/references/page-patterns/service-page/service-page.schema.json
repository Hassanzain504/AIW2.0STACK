{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "service-page.schema.json",
  "title": "Service page data",
  "description": "One file per service page, written by Stage 6 (copy deck) into Pipeline Data/copy/pages/services/{slug}.json. The component reads this plus brand-dna. Nothing on the page is hardcoded.",
  "type": "object",
  "required": ["slug", "name", "h1", "meta", "problem", "includes", "process", "credentials", "faq", "towns", "cta"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "description": "Short service name for nav, cards and breadcrumbs" },
    "h1": { "type": "string", "description": "Must name the service AND the area. A slogan here is an audit failure." },
    "meta": {
      "type": "object",
      "required": ["title", "description"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 160 }
      }
    },
    "banner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subhead": { "type": "string" },
        "pills": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
      }
    },
    "problem": {
      "type": "object",
      "description": "The problem in the end customer's own words. Voices come from research, never invented.",
      "required": ["heading", "lead"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "lead": { "type": "string" },
        "voices": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["quote", "source"],
            "additionalProperties": false,
            "properties": {
              "quote": { "type": "string" },
              "source": { "type": "string", "description": "Where this phrasing came from. Traceable to a research dump." }
            }
          }
        }
      }
    },
    "includes": {
      "type": "object",
      "required": ["heading", "items"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "additionalProperties": false,
            "properties": { "title": { "type": "string" }, "body": { "type": "string" } }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "description": "A real ordered sequence, which is why the steps are numbered. Every step carries a timescale.",
      "required": ["heading", "steps"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["title", "body", "timescale"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "body": { "type": "string" },
              "timescale": { "type": "string", "description": "Real, from completed jobs. Not a generic promise." }
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["heading", "items"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "detail"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "detail": { "type": "string" } }
          }
        },
        "disclaimer": {
          "type": "object",
          "description": "Optional. Use where the niche has a common false-authority pattern to distance from, e.g. federal agency seals.",
          "additionalProperties": false,
          "properties": { "heading": { "type": "string" }, "body": { "type": "string" } }
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Optional but strongly preferred. Published ranges stop the visitor calling three competitors for a number.",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "footnote": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["situation", "range"],
            "additionalProperties": false,
            "properties": {
              "situation": { "type": "string" },
              "range": { "type": "string" },
              "insurance": { "type": "string" }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "object",
      "description": "Client's own work only. Stock photography is an audit failure.",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["filename", "alt", "caption", "town"],
            "additionalProperties": false,
            "properties": {
              "filename": { "type": "string", "description": "Resolves to /work/{filename}" },
              "alt": { "type": "string" },
              "caption": { "type": "string" },
              "town": { "type": "string" }
            }
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "filterTag": { "type": "string", "description": "Optional. Selects matching items from brand-dna.reviews.items." }
      }
    },
    "faq": {
      "type": "object",
      "description": "Eight to twelve real questions. This is the block AI answers pull from, so the floor is 8.",
      "required": ["heading", "items"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 8,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["q", "a"],
            "additionalProperties": false,
            "properties": { "q": { "type": "string" }, "a": { "type": "string" } }
          }
        }
      }
    },
    "towns": {
      "type": "object",
      "description": "Internal links to the town pages. This is half of the internal linking model.",
      "required": ["heading", "items"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "note": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "href": { "type": "string" } }
          }
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["heading", "body"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "primary": { "type": "string" },
        "secondary": { "type": "string" }
      }
    }
  }
}
